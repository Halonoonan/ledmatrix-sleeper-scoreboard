{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sleeper Fantasy Scoreboard Configuration",
  "description": "Displays all matchups from a Sleeper fantasy football league.",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable or disable the plugin"
    },
    "display_duration": {
      "type": "number",
      "default": 45,
      "minimum": 5,
      "maximum": 600,
      "description": "How long the LEDMatrix controller keeps this plugin active"
    },
    "league_id": {
      "type": "string",
      "default": "1386603818250158080",
      "title": "Sleeper League ID",
      "description": "The numeric Sleeper league ID"
    },
    "week": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 25,
      "title": "Fantasy Week",
      "description": "Use 0 to automatically use Sleeper's current NFL week"
    },
    "matchup_display_seconds": {
      "type": "number",
      "default": 7,
      "minimum": 2,
      "maximum": 60,
      "title": "Seconds Per Matchup",
      "description": "How long each matchup remains on screen"
    },
    "update_interval": {
      "type": "integer",
      "default": 60,
      "minimum": 15,
      "maximum": 3600,
      "title": "Score Refresh Interval",
      "description": "How often to refresh Sleeper scores, in seconds"
    },
    "show_week_header": {
      "type": "boolean",
      "default": true,
      "description": "Show the current week at the top"
    },
    "show_matchup_number": {
      "type": "boolean",
      "default": true,
      "description": "Show the matchup position, such as 2/6"
    },
    "name_max_length": {
      "type": "integer",
      "default": 16,
      "minimum": 6,
      "maximum": 30,
      "description": "Maximum displayed team-name length"
    },
    "header_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        215,
        0
      ],
      "description": "Header RGB color"
    },
    "team_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        255,
        255
      ],
      "description": "Team-name RGB color"
    },
    "score_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0,
        255,
        255
      ],
      "description": "Fantasy-score RGB color"
    }
  },
  "required": [
    "league_id"
  ]
}
